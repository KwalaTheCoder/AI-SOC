# Copy this file to .env and replace placeholders locally.
# Never commit .env or real credentials.

# Local web server
SOC_BIND_HOST=127.0.0.1
SOC_PORT=5000
# Optional: leave blank for local-only use. If set, also configure the
# dashboard browser's local storage key `soc_api_token` with the same value.
SOC_API_TOKEN=
SOC_MAX_UPLOAD_MB=25
SOC_MAX_AI_GROUPS=5
SOC_DETECTION_WINDOW_SECONDS=300
SOC_DB_PATH=./data/events.db

# Optional Splunk connection
SPLUNK_HOST=127.0.0.1
SPLUNK_PORT=8089
SPLUNK_INDEX=suricata
SPLUNK_SOURCETYPE=suricata:eve:json
SPLUNK_LOOKBACK=-15m
SPLUNK_POLL_SECONDS=2
SPLUNK_USERNAME=
SPLUNK_PASSWORD=
SPLUNK_SESSION_TOKEN=

# Local Ollama service
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_SECONDS=30

# Local MITRE ATT&CK knowledge base
MITRE_CHROMA_DIR=./data/chroma
MITRE_COLLECTION=mitre_attack
MITRE_FILE=./mitre_techniques.json
MITRE_GRAPH_FILE=./data/mitre_graph.json
